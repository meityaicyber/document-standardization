# Copy to .env and adjust. Read by the GUI on start-up.
# The system is air-gapped: the model (Nemotron 3 Nano Omni) runs locally and nothing is downloaded at runtime.

# --- Model serving -------------------------------------------------------------
# Preferred: a local OpenAI-compatible server (vLLM / SGLang / TensorRT-LLM), e.g.
#   vllm serve models/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-BF16 \
#        --served-model-name nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-BF16 \
#        --trust-remote-code --enable-prefix-caching
# R2J_MODEL_ENDPOINT=http://127.0.0.1:8000/v1
# Name the server was started with, if not the Hugging Face repo id:
# R2J_NEMOTRON_3_NANO_OMNI_SERVED_NAME=nemotron-omni
# R2J_API_KEY=

# Alternative: in-process Transformers from local weights
# (MODELS_DIR/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-BF16, or an explicit path).
# MODELS_DIR=D:\models
# R2J_NEMOTRON_3_NANO_OMNI_PATH=D:\models\Nemotron-3-Nano-Omni-30B-A3B-Reasoning-BF16

# Extra multimodal processor arguments, as JSON.
# R2J_NEMOTRON_3_NANO_OMNI_MM_PROCESSOR_KWARGS={}

# --- Storage and quality gates ---------------------------------------------------
# DEEP_STORAGE_DIR=D:\deep_storage
# PAGE_RECALL_THRESHOLD=0.97   # share of a page's text-layer words pass 1 must reproduce
# COVERAGE_THRESHOLD=0.95      # share of transcript text pass 2 must place in schema fields
# PASS1_RETRIES=2
# PASS2_RETRIES=2
# RENDER_DPI=200
# MIN_FIGURE_BOX_PT=40         # smaller image placements stay visible instead of becoming tags

# --- DOCX conversion -------------------------------------------------------------
# DOCX_CONVERTER=auto          # auto | word | libreoffice
