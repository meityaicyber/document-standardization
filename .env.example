# Copy to .env and adjust. Read by the GUI on start-up.
# The system is air-gapped: every model runs locally and nothing is downloaded at runtime.

# --- Model serving -------------------------------------------------------------
# Preferred: a local OpenAI-compatible server per model (vLLM / SGLang / TensorRT-LLM), e.g.
#   vllm serve /models/gemma-4-31B-it --served-model-name google/gemma-4-31B-it --enable-prefix-caching
# R2J_MODEL_ENDPOINT applies to every model; R2J_<MODEL>_ENDPOINT overrides it for one.
# R2J_GEMMA_4_31B_ENDPOINT=http://127.0.0.1:8000/v1
# R2J_LLAMA_4_SCOUT_ENDPOINT=http://127.0.0.1:8001/v1
# R2J_NEMOTRON_3_NANO_OMNI_ENDPOINT=http://127.0.0.1:8002/v1
# Name the server was started with, if not the Hugging Face repo id:
# R2J_GEMMA_4_31B_SERVED_NAME=gemma-4-31b
# R2J_API_KEY=

# Alternative: in-process Transformers from local weights (MODELS_DIR/<folder> or R2J_<MODEL>_PATH).
# MODELS_DIR=D:\models
# R2J_GEMMA_4_31B_PATH=D:\models\gemma-4-31B-it

# Extra multimodal processor arguments per model, as JSON (e.g. an image token budget).
# R2J_GEMMA_4_31B_MM_PROCESSOR_KWARGS={}

# --- Storage and quality gates ---------------------------------------------------
# DEEP_STORAGE_DIR=D:\deep_storage
# PAGE_RECALL_THRESHOLD=0.97   # share of a page's text-layer words pass 1 must reproduce
# COVERAGE_THRESHOLD=0.95      # share of transcript text pass 2 must place in schema fields
# PASS1_RETRIES=2
# PASS2_RETRIES=2
# RENDER_DPI=200
# MIN_FIGURE_BOX_PT=40         # smaller image placements stay visible instead of becoming tags

# --- DOCX conversion -------------------------------------------------------------
# DOCX_CONVERTER=auto          # auto | word | libreoffice
